{
  "name": "dsh-relay-balance",
  "version": "3.5.2",
  "type": "module",
  "description": "Relay usage and balance widget for DeepSeek Harness: a draggable Apple-style liquid-glass card plus a settings page, with auto-detection for sub2api, new-api/one-api, OpenRouter and other OpenAI-compatible relays, plus the official DeepSeek account balance.",
  "exports": {
    ".": "./index.js",
    "./providers": "./providers.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "providers.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "verify-providers.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "sub2api",
    "new-api",
    "one-api",
    "openrouter",
    "relay",
    "balance",
    "usage",
    "glassmorphism"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MLMLZJ/dsh-plugins.git",
    "directory": "dsh-relay-balance"
  },
  "homepage": "https://github.com/MLMLZJ/dsh-plugins/tree/main/dsh-relay-balance#readme",
  "bugs": {
    "url": "https://github.com/MLMLZJ/dsh-plugins/issues"
  },
  "author": "MLMLZJ"
}